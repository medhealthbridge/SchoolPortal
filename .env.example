# ---------------------------------------------------------------------------
# Database. Two URLs on purpose.
#
#   DATABASE_URL      the owner. Migrations and tests only.
#   APP_DATABASE_URL  app_user, which is NOBYPASSRLS and not the table owner.
#                     This is the one the running app uses, and it is what
#                     keeps one school out of another's rows.
#
# If APP_DATABASE_URL is missing in production the app refuses to start, because
# it would otherwise connect as the owner and row-level security would be off.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://schoolportal:schoolportal@127.0.0.1:5432/schoolportal
APP_DATABASE_URL=postgres://app_user:app_user@127.0.0.1:5432/schoolportal

# The domain schools get a subdomain of. No scheme, port allowed in dev.
ROOT_DOMAIN=lvh.me:3000
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# Seeded on first db:seed. Change both before going live — this account
# reaches every school. Production refuses a password under 12 characters.
PLATFORM_ADMIN_EMAIL=admin@yourapp.com
PLATFORM_ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------------------
# Delivery. Leave these empty and every message still lands in the outbox and
# on the admin Outbox screen — which is what you want in dev and in tests.
# Set them and the same messages also go out for real.
#
# Any provider with a JSON HTTP API fits: give the URL, the key, and the
# template that names its fields. {{to}}, {{subject}}, {{body}} and {{from}}
# are filled in. Examples are in README, "Mail and SMS".
# ---------------------------------------------------------------------------
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=
# EMAIL_FROM=SchoolPortal <no-reply@yourapp.com>
# EMAIL_BODY_TEMPLATE={"from":"{{from}}","to":["{{to}}"],"subject":"{{subject}}","text":"{{body}}"}

# SMS_API_URL=https://api.semaphore.co/api/v4/messages
# SMS_API_KEY=
# SMS_FROM=SCHOOLPORTAL
# SMS_BODY_TEMPLATE={"apikey":"{{key}}","number":"{{to}}","message":"{{body}}","sendername":"{{from}}"}

# ---------------------------------------------------------------------------
# Uploaded files: the school logo today, photos later.
#
# Unset, they go to .uploads/ on this machine's disk and are served from
# /uploads/<key>. That is fine for dev and for one VPS with a persistent
# volume (say ALLOW_LOCAL_UPLOADS=yes so production stops objecting), and
# wrong on a serverless host or behind two instances.
#
# Any S3-compatible bucket works: AWS, Cloudflare R2, DigitalOcean Spaces,
# Wasabi, MinIO. Signed in-process, so there is no SDK to install.
# ---------------------------------------------------------------------------
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_PUBLIC_URL=https://files.yourapp.com                  # where readers fetch them
ALLOW_LOCAL_UPLOADS=yes

# ---------------------------------------------------------------------------
# Taking payment online. Unset, the Pay button never appears and invoices are
# settled by transfer and recorded by hand, which is how the plan has it.
#
# Set, a school can pay its invoice at the provider's own checkout. Only the
# signed webhook marks an invoice paid — a payer who reaches the thank-you
# page has not necessarily paid. PayMongo's shapes are the defaults; the
# PAYMENTS_*_PATH variables point at the same things in another provider's.
# ---------------------------------------------------------------------------
# PAYMENTS_API_URL=https://api.paymongo.com/v1/links
# PAYMENTS_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=
# PAYMENTS_BODY_TEMPLATE=
# PAYMENTS_CHECKOUT_URL_PATH=data.attributes.checkout_url
# PAYMENTS_EVENT_TYPE_PATH=data.attributes.type
# PAYMENTS_EVENT_PAID_VALUE=payment.paid
# PAYMENTS_REFERENCE_PATH=data.attributes.data.attributes.reference_number
# PAYMENTS_AMOUNT_PATH=data.attributes.data.attributes.amount
# PAYMENTS_PAYMENT_ID_PATH=data.attributes.data.id

# ---------------------------------------------------------------------------
# The scheduled runner. Any cron that can send an HTTP request will do:
#   curl -X POST https://admin.yourapp.com/api/cron/run \
#        -H "Authorization: Bearer $CRON_SECRET"
# Without it the endpoint refuses every caller.
# ---------------------------------------------------------------------------
CRON_SECRET=
